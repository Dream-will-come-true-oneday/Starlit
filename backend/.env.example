# 复制此文件为 .env 并填写生产配置
# SECRET_KEY 必须修改！生成方式：python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# 数据库连接（docker-compose 内部地址）
DATABASE_URL=postgresql://starlit:starlit_pass@db:5432/starlit

# 前端域名（CORS 白名单，逗号分隔）
CORS_ORIGINS=https://your-domain.com

# DeepSeek LLM（每日对话练习用，去 platform.deepseek.com 申请）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
